# このファイルを .env にコピーして、自分のAPIキーを設定してください。
# APIキーは各自で用意します(.env は .gitignore 済みでコミットされません)。

# --- APIキー ---
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 任意設定(省略時のデフォルトで動きます)---
# 既定プロファイル(profiles/<名前>.toml)。省略時は default
# SIKUN_PROFILE=default
# 対象LANに接続したホスト経由でbashを実行する場合のSSH先
# SIKUN_SSH_TARGET=user@192.168.11.37
# コスト上限($)ごとに続行確認。0/未設定なら確認なし
# SIKUN_MAX_COST=0

# --- モデル上書き(通常はプロファイル側で指定)---
# SIKUN_GEMINI_MODEL=gemini-3.5-flash

# --- mobsf プラグイン用(モバイルアプリ静的解析。任意)---
# MobSFサーバーを別途起動し(例: docker run -p 8000:8000 opensecurity/mobile-security-framework-mobsf)、
# 管理画面の「API Docs」に表示されるキーを設定する
# MOBSF_URL=http://127.0.0.1:8000
# MOBSF_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
